@prefix core: <http://example.org/core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology
#################################################################

<http://example.org/core>
    rdf:type owl:Ontology ;
    rdfs:label "Protein Domain Core Ontology"@en ;
    rdfs:comment "Core ontology for proteins, domain types, domain occurrences, positional context, functional tags, and binding targets."@en .

#################################################################
# Classes
#################################################################

### Core biological entities
core:Entity rdf:type owl:Class ;
    rdfs:label "Entity"@en .

core:Protein rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "Protein"@en .

core:DomainType rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "Domain type"@en ;
    rdfs:comment "A reusable domain family/type concept, e.g. InterPro domain type."@en .

core:DomainOccurrence rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "Domain occurrence"@en ;
    rdfs:comment "A concrete occurrence of a domain in a particular protein sequence."@en .

core:SequenceSegment rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "Sequence segment"@en ;
    rdfs:comment "A contiguous sequence interval belonging to a domain occurrence."@en .

### Annotation vocabulary root
core:AnnotationTerm rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "Annotation term"@en .

### DOP branch
core:PositionalCategory rdf:type owl:Class ;
    rdfs:subClassOf core:AnnotationTerm ;
    rdfs:label "Positional category"@en .

core:TopologyContext rdf:type owl:Class ;
    rdfs:subClassOf core:AnnotationTerm ;
    rdfs:label "Topology context"@en .

core:ProximityCategory rdf:type owl:Class ;
    rdfs:subClassOf core:AnnotationTerm ;
    rdfs:label "Proximity category"@en .

core:ContinuityCategory rdf:type owl:Class ;
    rdfs:subClassOf core:AnnotationTerm ;
    rdfs:label "Continuity category"@en .

core:OrdinalPositionCategory rdf:type owl:Class ;
    rdfs:subClassOf core:AnnotationTerm ;
    rdfs:label "Ordinal position category"@en .

### DOF branch
core:FunctionalTag rdf:type owl:Class ;
    rdfs:subClassOf core:AnnotationTerm ;
    rdfs:label "Functional tag"@en .

### DOT branch
core:BindingTargetTerm rdf:type owl:Class ;
    rdfs:subClassOf core:AnnotationTerm ;
    rdfs:label "Binding target term"@en .

### Cross-reference / external term classes
core:GOTerm rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "GO term"@en .

core:GOMolecularFunction rdf:type owl:Class ;
    rdfs:subClassOf core:GOTerm ;
    rdfs:label "GO molecular function term"@en .

core:GOBiologicalProcess rdf:type owl:Class ;
    rdfs:subClassOf core:GOTerm ;
    rdfs:label "GO biological process term"@en .

core:GOCellularComponent rdf:type owl:Class ;
    rdfs:subClassOf core:GOTerm ;
    rdfs:label "GO cellular component term"@en .

core:ReactomePathway rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "Reactome pathway"@en .

core:KEGGEntry rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "KEGG entry"@en .

core:ChEBIEntity rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "ChEBI entity"@en .

core:PROTerm rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "Protein Ontology term"@en .

core:SOFeature rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "Sequence Ontology feature"@en .

core:ELMMotif rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "ELM motif"@en .

core:CATHSuperfamily rdf:type owl:Class ;
    rdfs:subClassOf core:Entity ;
    rdfs:label "CATH superfamily"@en .

#################################################################
# Object properties
#################################################################

### Protein / occurrence / type structure
core:hasDomainOccurrence rdf:type owl:ObjectProperty ;
    rdfs:domain core:Protein ;
    rdfs:range core:DomainOccurrence ;
    owl:inverseOf core:occursInProtein ;
    rdfs:label "has domain occurrence"@en .

core:occursInProtein rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range core:Protein ;
    rdfs:label "occurs in protein"@en .

core:hasDomainType rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range core:DomainType ;
    owl:inverseOf core:isDomainTypeOfOccurrence ;
    rdfs:label "has domain type"@en .

core:isDomainTypeOfOccurrence rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:DomainOccurrence ;
    rdfs:label "is domain type of occurrence"@en .

### Occurrence order / neighborhood
core:precedesOccurrence rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range core:DomainOccurrence ;
    owl:inverseOf core:followsOccurrence ;
    rdfs:label "precedes occurrence"@en .

core:followsOccurrence rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range core:DomainOccurrence ;
    rdfs:label "follows occurrence"@en .

core:adjacentToOccurrence rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range core:DomainOccurrence ;
    rdfs:label "adjacent to occurrence"@en .

### Aggregated domain-type pattern relations
core:cooccursWithDomainType rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:DomainType ;
    rdfs:label "co-occurs with domain type"@en .

core:precedesDomainTypePattern rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:DomainType ;
    rdfs:label "precedes domain type pattern"@en .

### Segment structure
core:hasSegment rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range core:SequenceSegment ;
    rdfs:label "has segment"@en .

### Annotation attachment to DomainType
core:hasFunctionalTag rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:FunctionalTag ;
    rdfs:label "has functional tag"@en .

core:hasBindingTarget rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:BindingTargetTerm ;
    rdfs:label "has binding target"@en .

core:hasPositionalCategory rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:PositionalCategory ;
    rdfs:label "has positional category"@en .

core:hasTopologyContext rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:TopologyContext ;
    rdfs:label "has topology context"@en .

core:hasProximityCategory rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:ProximityCategory ;
    rdfs:label "has proximity category"@en .

core:hasContinuityCategory rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:ContinuityCategory ;
    rdfs:label "has continuity category"@en .

### Optional occurrence-level annotation attachment
core:occurrenceHasPositionalCategory rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range core:PositionalCategory ;
    rdfs:label "occurrence has positional category"@en .

core:occurrenceHasTopologyContext rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range core:TopologyContext ;
    rdfs:label "occurrence has topology context"@en .

core:occurrenceHasProximityCategory rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range core:ProximityCategory ;
    rdfs:label "occurrence has proximity category"@en .

### Cross-reference annotation on DomainType
core:hasGOMolecularFunctionTerm rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:GOMolecularFunction ;
    rdfs:label "has GO molecular function term"@en .

core:hasGOBiologicalProcessTerm rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:GOBiologicalProcess ;
    rdfs:label "has GO biological process term"@en .

core:hasGOCellularComponentTerm rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:GOCellularComponent ;
    rdfs:label "has GO cellular component term"@en .

core:hasReactomePathway rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:ReactomePathway ;
    rdfs:label "has Reactome pathway"@en .

core:hasKEGGEntry rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:KEGGEntry ;
    rdfs:label "has KEGG entry"@en .

core:hasCATHSuperfamily rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:CATHSuperfamily ;
    rdfs:label "has CATH superfamily"@en .

core:hasBindingTargetChEBI rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf core:hasBindingTarget ;
    rdfs:domain core:DomainType ;
    rdfs:range core:ChEBIEntity ;
    rdfs:label "has binding target ChEBI"@en .

core:hasPROTerm rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:PROTerm ;
    rdfs:label "has PRO term"@en .

core:hasSOFeature rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:SOFeature ;
    rdfs:label "has SO feature"@en .

core:hasELMMotif rdf:type owl:ObjectProperty ;
    rdfs:domain core:DomainType ;
    rdfs:range core:ELMMotif ;
    rdfs:label "has ELM motif"@en .

#################################################################
# Datatype properties
#################################################################

### Shared metadata
core:accession rdf:type owl:DatatypeProperty ;
    rdfs:domain core:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "accession"@en .

core:preferredLabel rdf:type owl:DatatypeProperty ;
    rdfs:domain core:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "preferred label"@en .

core:definition rdf:type owl:DatatypeProperty ;
    rdfs:domain core:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "definition"@en .

core:sourceDatabase rdf:type owl:DatatypeProperty ;
    rdfs:domain core:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "source database"@en .

### Protein properties
core:proteinLength rdf:type owl:DatatypeProperty ;
    rdfs:domain core:Protein ;
    rdfs:range xsd:integer ;
    rdfs:label "protein length"@en .

### DomainOccurrence coordinates / metrics
core:startPos rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:integer ;
    rdfs:label "start position"@en .

core:endPos rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:integer ;
    rdfs:label "end position"@en .

core:occurrenceLength rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:integer ;
    rdfs:label "occurrence length"@en .

core:copyIndexWithinProtein rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:integer ;
    rdfs:label "copy index within protein"@en .

core:relativeStart rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:decimal ;
    rdfs:label "relative start"@en .

core:relativeEnd rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:decimal ;
    rdfs:label "relative end"@en .

core:relativeMidpoint rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:decimal ;
    rdfs:label "relative midpoint"@en .

core:gapFromPrev rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:integer ;
    rdfs:label "gap from previous occurrence"@en .

core:gapToNext rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:integer ;
    rdfs:label "gap to next occurrence"@en .

core:adjacentToPrev rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "adjacent to previous occurrence"@en .

core:adjacentToNext rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:boolean ;
    rdfs:label "adjacent to next occurrence"@en .

core:nearestTmDistance rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:integer ;
    rdfs:label "nearest transmembrane distance"@en .

core:nearestActiveSiteDistance rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:integer ;
    rdfs:label "nearest active site distance"@en .

core:nearestSignalCleavageDistance rdf:type owl:DatatypeProperty ;
    rdfs:domain core:DomainOccurrence ;
    rdfs:range xsd:integer ;
    rdfs:label "nearest signal cleavage distance"@en .

### SequenceSegment coordinates
core:segmentStart rdf:type owl:DatatypeProperty ;
    rdfs:domain core:SequenceSegment ;
    rdfs:range xsd:integer ;
    rdfs:label "segment start"@en .

core:segmentEnd rdf:type owl:DatatypeProperty ;
    rdfs:domain core:SequenceSegment ;
    rdfs:range xsd:integer ;
    rdfs:label "segment end"@en .

#################################################################
# Logical axioms
#################################################################

core:DomainOccurrence rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty core:occursInProtein ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass core:Protein
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty core:hasDomainType ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass core:DomainType
    ] .

core:SequenceSegment rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty core:segmentStart ;
      owl:someValuesFrom xsd:integer
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty core:segmentEnd ;
      owl:someValuesFrom xsd:integer
    ] .
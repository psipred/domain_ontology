    core:domainOrderText "INTERPRO:IPR000197 > INTERPRO:IPR003101 > INTERPRO:IPR001487 > INTERPRO:IPR010303 > INTERPRO:IPR056484 > INTERPRO:IPR031162 > INTERPRO:IPR000433 > INTERPRO:IPR000197 > INTERPRO:IPR014744" ;
    core:proteinSubcellularLocationText "Cytoplasm {ECO:0000269|PubMed:12929931, ECO:0000269|PubMed:20940255}. Nucleus {ECO:0000269|PubMed:12929931, ECO:0000269|PubMed:14645221, ECO:0000269|PubMed:16219772, ECO:0000269|PubMed:16574662, ECO:0000269|PubMed:17761950, ECO:0000269|PubMed:20940255, ECO:0000269|PubMed:25593309}. Chromosome {ECO:0000269|PubMed:14645221, ECO:0000269|PubMed:25818647}. Note=Localizes to active chromatin: Colocalizes with histone H3 acetylated and/or crotonylated at 'Lys-18' (H3K18ac and H3K18cr, respectively) (PubMed:25818647). In the presence of ALX1 relocalizes from the cytoplasm to the nucleus. Colocalizes with ROCK2 in the nucleus (PubMed:12929931). Localizes to sites of DNA damage (PubMed:25593309). {ECO:0000269|PubMed:12929931, ECO:0000269|PubMed:25593309, ECO:0000269|PubMed:25818647}." .

uniprot:Q92793 a core:Protein,

uniprot:P53778 a core:Protein,
        owl:NamedIndividual ;
    rdfs:label "Protein P53778" ;
    core:domainOrderText "INTERPRO:IPR000719" ;
    core:proteinSubcellularLocationText "Cytoplasm. Nucleus. Mitochondrion. Note=Mitochondrial when associated with SH3BP5. In skeletal muscle colocalizes with SNTA1 at the neuromuscular junction and throughout the sarcolemma (By similarity). {ECO:0000250}." .

uniprot:P53779 a core:Protein,
        owl:NamedIndividual ;
    rdfs:label "Protein P53779" ;
    core:domainOrderText "INTERPRO:IPR000719" ;
    core:proteinSubcellularLocationText "Cytoplasm {ECO:0000269|PubMed:16737965}. Membrane {ECO:0000269|PubMed:16737965}; Lipid-anchor {ECO:0000269|PubMed:16737965}. Nucleus {ECO:0000269|PubMed:16737965}. Mitochondrion {ECO:0000269|PubMed:16737965}. Note=Palmitoylation regulates MAPK10 trafficking to cytoskeleton. Recruited to the mitochondria in the presence of SARM1 (By similarity). {ECO:0000250}." .


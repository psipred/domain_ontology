uniprot:O43889 a core:Protein,
        owl:NamedIndividual ;
    rdfs:label "Protein O43889" ;
    core:domainOrderText "INTERPRO:IPR004827" ;
    core:proteinSubcellularLocationText "[Processed cyclic AMP-responsive element-binding protein 3]: Nucleus. Note=Upon RIP activation the transcriptional active processed cyclic AMP-responsive element-binding protein 3 form translocates into the nucleus. Detected in the nucleus upon dendritic cell maturation and RIP activation. Colocalizes with CREBRF in nuclear foci. Colocalizes with CREBZF in promyelocytic leukemia protein nuclear bodies (PML-NB). {ECO:0000269|PubMed:10675342, ECO:0000269|PubMed:15705566, ECO:0000269|PubMed:18391022, ECO:0000269|PubMed:20546900}." .


uniprot:O75899 a core:Protein,
        owl:NamedIndividual ;
    rdfs:label "Protein O75899" ;
    core:domainOrderText "INTERPRO:IPR001828 > INTERPRO:IPR017978 > INTERPRO:IPR041689" ;
    core:proteinSubcellularLocationText "Cell membrane {ECO:0000269|PubMed:10328880, ECO:0000269|PubMed:15617512, ECO:0000269|PubMed:9872316}; Multi-pass membrane protein {ECO:0000305}. Postsynaptic cell membrane {ECO:0000250|UniProtKB:O88871}; Multi-pass membrane protein {ECO:0000305}. Note=Coexpression of GABBR1 and GABBR2 is required for GABBR1 maturation and transport to the plasma membrane. In contrast, GABBR2 does not depend on GABBR1 for transport to the cell membrane. {ECO:0000269|PubMed:15617512}." .

